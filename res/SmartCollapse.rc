#include <winres.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP     ICON "app.ico"
IDI_PAUSED  ICON "paused.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "SmartCollapse.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SC_VERSION_MAJOR,SC_VERSION_MINOR,SC_VERSION_PATCH,0
 PRODUCTVERSION SC_VERSION_MAJOR,SC_VERSION_MINOR,SC_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "zalexdev"
            VALUE "FileDescription", "SmartCollapse"
            VALUE "FileVersion", SC_VERSION_TEXT
            VALUE "InternalName", "SmartCollapse"
            VALUE "LegalCopyright", "zalexdev, github.com/zalexdev/SmartCollapse"
            VALUE "OriginalFilename", "SmartCollapse.exe"
            VALUE "ProductName", "SmartCollapse"
            VALUE "ProductVersion", SC_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
